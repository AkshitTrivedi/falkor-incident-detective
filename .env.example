# Copy to .env and fill in. Any ONE key is enough; with none, the app answers
# with the rules diagnosis (no model). .env is git-ignored, never commit it.

# Free keys: Groq console.groq.com, Gemini aistudio.google.com,
# NVIDIA build.nvidia.com, Mistral console.mistral.ai, OpenRouter openrouter.ai
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# FalkorDB. Defaults to the local Docker container.
# FALKORDB_URL=falkor://localhost:6379
# GRAPH_NAME=incidents

# Optional: pin one model and skip the fallback chain.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.1-flash-lite

# Optional: AUTO_RESEED=0 keeps the graph as is; LOG_LEVEL=WARNING quiets the terminal.
# AUTO_RESEED=1
# LOG_LEVEL=INFO
